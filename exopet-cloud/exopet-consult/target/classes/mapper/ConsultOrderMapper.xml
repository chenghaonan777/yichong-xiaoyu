<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.exopet.consult.mapper.ConsultOrderMapper">

    <resultMap id="BaseResultMap" type="com.exopet.consult.entity.ConsultOrder">
        <id     column="id"               property="id"/>
        <result column="order_no"         property="orderNo"/>
        <result column="user_id"          property="userId"/>
        <result column="pet_id"           property="petId"/>
        <result column="doctor_id"        property="doctorId"/>
        <result column="type"             property="type"/>
        <result column="status"           property="status"/>
        <result column="amount"           property="amount"/>
        <result column="symptom_desc"     property="symptomDesc"/>
        <result column="symptom_images"   property="symptomImages"/>
        <result column="breed_type"       property="breedType"/>
        <result column="breed_name"       property="breedName"/>
        <result column="diagnosis_result" property="diagnosisResult"/>
        <result column="ai_consult_id"    property="aiConsultId"/>
        <result column="paid_at"          property="paidAt"/>
        <result column="finished_at"      property="finishedAt"/>
        <result column="created_at"       property="createdAt"/>
        <result column="updated_at"       property="updatedAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, order_no, user_id, pet_id, doctor_id, type, status, amount,
        symptom_desc, symptom_images, breed_type, breed_name,
        diagnosis_result, ai_consult_id, paid_at, finished_at,
        created_at, updated_at
    </sql>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM consult_order
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

    <select id="selectByOrderNo" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM consult_order
        WHERE order_no = #{orderNo}
        LIMIT 1
    </select>

</mapper>
