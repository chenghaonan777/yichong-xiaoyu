<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis://DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.exopet.hospital.mapper.HospitalAppointmentMapper">

    <resultMap id="BaseResultMap" type="com.exopet.hospital.entity.HospitalAppointment">
        <id     column="id"             property="id"/>
        <result column="hospital_id"    property="hospitalId"/>
        <result column="user_id"        property="userId"/>
        <result column="pet_id"         property="petId"/>
        <result column="appoint_date"   property="appointDate"/>
        <result column="time_slot"      property="timeSlot"/>
        <result column="contact_name"   property="contactName"/>
        <result column="contact_phone"  property="contactPhone"/>
        <result column="remark"         property="remark"/>
        <result column="status"         property="status"/>
        <result column="cancel_reason"  property="cancelReason"/>
        <result column="created_at"     property="createdAt"/>
        <result column="updated_at"     property="updatedAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, hospital_id, user_id, pet_id, appoint_date, time_slot,
        contact_name, contact_phone, remark, status, cancel_reason,
        created_at, updated_at
    </sql>

    <!-- ==================== 按用户ID查询预约（分页） ==================== -->
    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM hospital_appointment
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

    <!-- ==================== 按医院+日期查询预约 ==================== -->
    <select id="selectByHospitalIdAndDate" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM hospital_appointment
        WHERE hospital_id = #{hospitalId}
          AND appoint_date = #{appointDate}
        ORDER BY time_slot ASC
    </select>

</mapper>
